---
import Logo from "../assets/clm-logo.svg";
import { SITE } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer">
		<a href="/" class="footer__logo" aria-label="Cait Lorenzo-Mahon, home">
			<Logo aria-hidden="true" />
		</a>
		<p class="footer__note">
			This site is designed with performance and sustainability in mind - optimised for speed, accessibility, and a low carbon footprint.
		</p>
		<ul class="footer__links" role="list">
			<li><a class="text-link" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub<span class="visually-hidden"> (opens in new tab)</span></a></li>
			<li><a class="text-link" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span class="visually-hidden"> (opens in new tab)</span></a></li>
			<li><a class="text-link" href="/privacy/">Privacy</a></li>
		</ul>
		<a class="carbon-badge" href={SITE.carbon} target="_blank" rel="noopener noreferrer">
			<span class="carbon-badge__grade">A+</span>
			<span>Rated by Website Carbon</span>
			<span class="visually-hidden"> (opens in new tab)</span>
		</a>
		<p class="footer__copy">&copy; {year} {SITE.name}. Built with love in 🇬🇧 | 🏳️‍🌈 🏳️‍⚧️</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--section-gap);
		padding-block: 32px 40px;
		border-top: 1px solid var(--line);
		color: var(--slate);
		font-size: 0.9375rem;
	}

	.footer {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas:
			"logo links"
			"note badge"
			"copy copy";
		align-items: center;
		gap: 12px 48px;
	}

	.footer__logo {
		grid-area: logo;
		display: flex;
		align-items: center;
		justify-self: start;
		height: 44px;
		color: var(--panel);
	}

	:global(:root[data-theme="dark"]) .footer__logo {
		color: #fff;
	}

	.footer__logo :global(svg) {
		width: auto;
		height: 36px;
	}

	.footer__note {
		grid-area: note;
		max-width: 60ch;
	}

	.carbon-badge {
		grid-area: badge;
		justify-self: end;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 44px;
		padding: 5px 18px 5px 5px;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--ink);
		font-weight: 500;
		line-height: 1.25;
		text-decoration: none;
		transition:
			background-color 0.2s,
			color 0.2s;
	}

	.carbon-badge:hover {
		background: var(--ink);
		color: var(--paper);
	}

	.carbon-badge__grade {
		display: grid;
		flex: none;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: var(--accent);
		color: var(--on-accent);
		font-size: 0.8125rem;
		font-weight: 700;
	}

	.footer__links {
		grid-area: links;
		justify-self: end;
		display: flex;
		gap: 20px;
		color: var(--ink);
	}

	/* Roomier tap targets. */
	.footer__links a {
		display: inline-block;
		padding-block: 12px;
	}

	.footer__copy {
		grid-area: copy;
		margin-top: 12px;
		padding-top: 20px;
		border-top: 1px solid var(--line);
	}

	@media (max-width: 1000px) {
		.footer {
			grid-template-columns: 1fr;
			grid-template-areas:
				"logo"
				"note"
				"links"
				"badge"
				"copy";
			gap: 12px;
		}

		.footer__links,
		.carbon-badge {
			justify-self: start;
		}
	}
</style>

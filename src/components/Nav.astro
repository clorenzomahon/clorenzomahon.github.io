---
import Logo from "../assets/clm-logo.svg";
import ThemeToggle from "./ThemeToggle.astro";
import { NAV_LINKS } from "../data/site";

const path = Astro.url.pathname;
---

<header class="site-header">
	<nav class="nav container" aria-label="Primary navigation">
		<a href="/" class="nav__logo" aria-label="Cait Lorenzo-Mahon, home">
			<Logo aria-hidden="true" />
		</a>
		<ul class="nav__menu" id="nav-menu" role="list">
			{
				NAV_LINKS.map(({ href, label }) => (
					<li>
						<a
							href={href}
							class="nav__link"
							aria-current={path.startsWith(href) ? "page" : undefined}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="nav__actions">
			<ThemeToggle />
			<button
				class="nav__toggle"
				type="button"
				aria-expanded="false"
				aria-controls="nav-menu"
				aria-label="Open navigation menu"
			>
				<span aria-hidden="true"></span>
				<span aria-hidden="true"></span>
			</button>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--paper) 88%, transparent);
		backdrop-filter: blur(12px);
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		height: var(--header-height);
	}

	.nav__logo {
		display: flex;
		align-items: center;
		height: 44px;
		color: var(--panel);
	}

	:global(:root[data-theme="dark"]) .nav__logo {
		color: #fff;
	}

	.nav__logo :global(svg) {
		width: auto;
		height: 36px;
	}

	.nav__menu {
		display: flex;
		gap: 8px;
		margin-inline: auto 0;
	}

	.nav__link {
		display: block;
		padding: 8px 14px;
		border-radius: 999px;
		font-weight: 500;
		text-decoration: none;
		transition: background-color 0.2s;
	}

	.nav__link:hover,
	.nav__link[aria-current="page"] {
		background: var(--stone);
	}

	.nav__actions {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.nav__toggle {
		display: none;
		position: relative;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		cursor: pointer;
	}

	.nav__toggle span {
		position: absolute;
		left: 12px;
		width: 20px;
		height: 2px;
		background: var(--ink);
		transition: transform 0.2s;
	}

	.nav__toggle span:first-child {
		top: 17px;
	}

	.nav__toggle span:last-child {
		top: 25px;
	}

	.nav__toggle[aria-expanded="true"] span:first-child {
		transform: translateY(4px) rotate(45deg);
	}

	.nav__toggle[aria-expanded="true"] span:last-child {
		transform: translateY(-4px) rotate(-45deg);
	}

	@media (max-width: 640px) {
		.nav__toggle {
			display: block;
		}

		.nav__menu {
			display: none;
			position: fixed;
			inset: var(--header-height) 0 0;
			flex-direction: column;
			gap: 4px;
			height: calc(100dvh - var(--header-height));
			padding: 16px var(--gutter);
			background: var(--paper);
		}

		.nav__menu.is-open {
			display: flex;
		}

		.nav__link {
			padding: 12px 0;
			font-size: 2.25rem;
			letter-spacing: -0.03em;
			line-height: 1.1;
		}

		.nav__link:hover,
		.nav__link[aria-current="page"] {
			background: none;
			text-decoration: underline;
			text-decoration-thickness: 2px;
			text-underline-offset: 6px;
		}
	}
</style>

<script>
	const toggle = document.querySelector<HTMLButtonElement>(".nav__toggle");
	const menu = document.getElementById("nav-menu");

	if (toggle && menu) {
		const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>("a"));
		const isOpen = () => menu.classList.contains("is-open");

		const onKeydown = (e: KeyboardEvent) => {
			if (e.key === "Escape") return close();
			if (e.key !== "Tab") return;

			// Keep focus on the close button and menu links while the menu is open.
			const focusable = [toggle, ...links];
			const current = focusable.indexOf(document.activeElement as HTMLElement);
			const step = e.shiftKey ? -1 : 1;
			const next = (current + step + focusable.length) % focusable.length;

			// Moved by hand because the toggle sits after the menu in the page.
			e.preventDefault();
			focusable[next].focus();
		};

		function open() {
			menu!.classList.add("is-open");
			toggle!.setAttribute("aria-expanded", "true");
			toggle!.setAttribute("aria-label", "Close navigation menu");
			document.body.style.overflow = "hidden";
			document.addEventListener("keydown", onKeydown);
		}

		function close() {
			menu!.classList.remove("is-open");
			toggle!.setAttribute("aria-expanded", "false");
			toggle!.setAttribute("aria-label", "Open navigation menu");
			document.body.style.overflow = "";
			document.removeEventListener("keydown", onKeydown);
			toggle!.focus();
		}

		toggle.addEventListener("click", () => (isOpen() ? close() : open()));
		links.forEach((link) => link.addEventListener("click", close));
	}
</script>

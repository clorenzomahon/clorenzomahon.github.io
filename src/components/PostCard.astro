---
import type { CollectionEntry } from "astro:content";
import Logo from "../assets/clm-logo.svg";
import { formatDate, readingTime } from "../lib/content";

interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, excerpt, tag, publishedAt, image, imageAlt, draft } = post.data;
---

<article class="post-card">
	<div class="post-card__thumb">
		{
			image ? (
				<img src={image} alt={imageAlt ?? ""} width="1200" height="630" loading="lazy" decoding="async" />
			) : (
				<span class="post-card__mark" aria-hidden="true"><Logo /></span>
			)
		}
	</div>
	<div class="post-card__body">
		<p class="post-card__meta">
			<time datetime={publishedAt.toISOString().slice(0, 10)}>{formatDate(publishedAt)}</time> · {readingTime(post.body)}{draft && " · Draft"}
		</p>
		<h2 class="post-card__title"><a href={`/blog/${post.id}/`}>{title}</a></h2>
		<p class="post-card__excerpt">{excerpt}</p>
		<div class="post-card__foot">
			<span class="post-card__tag">{tag}</span>
			<span class="post-card__read" aria-hidden="true">
				Read post
				<svg viewBox="0 0 24 24"><path d="M6 18 18 6M8 6h10v10" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
			</span>
		</div>
	</div>
</article>

<style>
	.post-card {
		position: relative;
		display: grid;
		grid-template-columns: clamp(220px, 24vw, 340px) minmax(0, 720px);
		gap: clamp(24px, 3vw, 40px);
		align-items: start;
		padding-block: clamp(28px, 3.4vw, 44px);
		border-top: 1px solid var(--line);
	}

	.post-card__thumb {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-tile);
		background: var(--stone);
	}

	.post-card__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s var(--ease);
	}

	.post-card:hover .post-card__thumb img {
		transform: scale(1.03);
	}

	.post-card__mark {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		color: var(--mute);
		opacity: 0.45;
	}

	.post-card__mark :global(svg) {
		width: 30%;
		height: auto;
	}

	.post-card__body {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.post-card__meta {
		color: var(--mute);
		font-size: 0.9375rem;
	}

	.post-card__title {
		font-size: clamp(24px, 2.4vw, 34px);
		font-weight: 500;
		line-height: 1.12;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	.post-card__title a {
		text-decoration: none;
	}

	/* The whole card is the link. */
	.post-card__title a::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.post-card__excerpt {
		color: var(--slate);
		text-wrap: pretty;
	}

	.post-card__foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 20px;
		margin-top: 6px;
	}

	.post-card__tag {
		padding: 2px 12px;
		border-radius: 999px;
		background: var(--ink);
		color: var(--paper);
		font-size: 0.8125rem;
		line-height: 1.7;
	}

	.post-card__read {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		border-bottom: 1px solid var(--ink);
		font-size: 0.9375rem;
		font-weight: 500;
	}

	.post-card__read svg {
		width: 14px;
		height: 14px;
		transition: transform 0.25s var(--ease);
	}

	.post-card:hover .post-card__read svg {
		transform: translate(2px, -2px);
	}

	@media (max-width: 720px) {
		.post-card {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

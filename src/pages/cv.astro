---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { CV_FORM, SITE } from "../data/site";

const FIELDS = [
	{ name: "name", label: "Name", type: "text", autocomplete: "name" },
	{ name: "email", label: "Email address", type: "email", autocomplete: "email" },
	{ name: "job_title", label: "Job title", type: "text", autocomplete: "organization-title" },
	{ name: "company", label: "Company", type: "text", autocomplete: "organization" },
];
---

<Base title="Request My CV" description="Request a copy of Cait Lorenzo-Mahon's CV. A Front End and Drupal Developer working remotely across the UK and Europe.">
	<div class="container">
		<PageHero compact>
			<div slot="reveal" class="hero-grid"></div>
			<Fragment slot="title">Request my CV<span class="accent">.</span></Fragment>
			<p slot="intro">Tell me who you are and I'll get back to you with a copy.</p>
		</PageHero>

		<section class="cv section" aria-label="CV request form">
			<!-- Posts straight to Web3Forms without JS. With it, the script below stays on this page. -->
			<form class="cv__form" action="https://api.web3forms.com/submit" method="POST" data-cv-form>
				<input type="hidden" name="access_key" value={CV_FORM.key} />
				<input type="hidden" name="subject" value={CV_FORM.subject} />
				<input type="hidden" name="from_name" value="Portfolio CV request" />
				<input class="cv__trap" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
				<p class="cv__note">All fields are required.</p>

				{
					FIELDS.map(({ name, label, type, autocomplete }) => (
						<div class="cv__field">
							<label for={`cv-${name}`}>{label}</label>
							<input id={`cv-${name}`} name={name} type={type} autocomplete={autocomplete} required maxlength="200" />
						</div>
					))
				}

				<p class="cv__note">I'll only use these details to reply to your request. They reach me by email through Web3Forms. Read my <a class="text-link" href="/privacy/">privacy policy</a>.</p>
				<button class="btn btn--primary cv__submit" type="submit">Send request</button>
				<p class="cv__error" role="alert" data-cv-error hidden>
					Sorry, that didn't send. Please try again, or email me at <a class="text-link" href={`mailto:${SITE.email}?subject=${encodeURIComponent(CV_FORM.subject)}`}>{SITE.email}</a>.
				</p>
			</form>

			<div class="cv__done" tabindex="-1" data-cv-done hidden>
				<h2 class="cv__done-title">Thanks<span class="accent">.</span></h2>
				<p>I've got your request and I'll get back to you soon.</p>
			</div>
		</section>
	</div>
</Base>

<style>
	.cv {
		max-width: 560px;
	}

	.cv__form {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 24px;
	}

	.cv__form[hidden],
	.cv__trap {
		display: none;
	}

	.cv__field {
		display: flex;
		flex-direction: column;
		gap: 8px;
		width: 100%;
	}

	.cv__field label {
		font-weight: 500;
	}

	.cv__field input {
		width: 100%;
		min-height: 52px;
		padding: 12px 16px;
		border: var(--outline) solid var(--mute);
		border-radius: 12px;
		background: var(--paper);
		color: var(--ink);
		font: inherit;
		transition: border-color 0.2s;
	}

	.cv__field input:hover {
		border-color: var(--ink);
	}

	.cv__note {
		color: var(--slate);
		font-size: 0.9375rem;
	}

	.cv__submit[disabled] {
		opacity: 0.6;
		cursor: progress;
	}

	.cv__error {
		color: var(--ink);
	}

	.cv__done {
		display: flex;
		flex-direction: column;
		gap: 12px;
		font-size: clamp(18px, 1.6vw, 22px);
	}

	.cv__done[hidden] {
		display: none;
	}

	.cv__done:focus {
		outline: none;
	}

	.cv__done-title {
		font-size: clamp(38px, 5.4vw, 80px);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.045em;
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>("[data-cv-form]");
	const error = document.querySelector<HTMLElement>("[data-cv-error]");
	const done = document.querySelector<HTMLElement>("[data-cv-done]");
	const button = form?.querySelector<HTMLButtonElement>("button[type=submit]");

	if (form && error && done && button) {
		const label = button.textContent;

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			const data = Object.fromEntries(new FormData(form));
			error.hidden = true;
			button.disabled = true;
			button.textContent = "Sending...";

			try {
				if (!data.access_key) throw new Error("The form has no access key yet.");

				const response = await fetch(form.action, {
					method: "POST",
					headers: { "Content-Type": "application/json", Accept: "application/json" },
					body: JSON.stringify(data),
				});
				if (!response.ok) throw new Error(`Web3Forms replied ${response.status}.`);

				form.hidden = true;
				done.hidden = false;
				done.focus();
			} catch (problem) {
				console.error(problem);
				error.hidden = false;
				button.disabled = false;
				button.textContent = label;
			}
		});
	}
</script>

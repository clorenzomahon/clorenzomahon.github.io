---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import ContactPanel from "../components/ContactPanel.astro";
import MilestoneStack from "../components/MilestoneStack.astro";
import Logo from "../assets/clm-logo.svg";
import { CORE_SKILLS, IMPACT, SKILL_GROUPS } from "../data/about";
import { TECH_COLOURS } from "../data/tech-colours";
import { TECH_ICONS } from "../data/tech-icons";
---

<Base
	profile
	metaTitle="About Cait | Front End & Drupal Developer"
	description="Cait Lorenzo-Mahon is a designer turned developer, building fast, accessible, sustainable websites with Drupal, WordPress and React."
>
	<div class="container">
		<PageHero compact>
			<div slot="reveal" class="hero-grid"></div>
			<Fragment slot="title">Designer turned developer<span class="accent">.</span></Fragment>
		</PageHero>

		<section class="bio section" aria-labelledby="bio-heading">
			<div class="bio__text">
				<h2 id="bio-heading" class="section__title">I care how it looks and how it runs<span class="accent">.</span></h2>
				<p>I build <strong>fast, accessible, sustainable websites</strong>, from design and components through to Core Web Vitals, SEO and analytics, so the UX is never an afterthought.</p>
				<p>My instincts were shaped by years as a <strong>Senior Graphic Designer</strong>, where I learned colour theory, typography and visual hierarchy long before I wrote my first line of code. I still use all of it.</p>
				<p>I mainly work in <strong>Drupal and WordPress</strong>, and also create custom sites with <strong>React and Node.js</strong>. My background spans charity, healthcare, e-commerce and construction, plus a BSc in Computing &amp; IT studied part-time alongside full-time work.</p>
			</div>
			<div class="bio__card">
				<svg class="bio__filter" width="0" height="0" aria-hidden="true">
					<filter id="about-duotone" color-interpolation-filters="sRGB">
						<feColorMatrix type="saturate" values="0" />
						<feComponentTransfer>
							<feFuncR type="table" tableValues="0.16 0.95" />
							<feFuncG type="table" tableValues="0.09 0.92" />
							<feFuncB type="table" tableValues="0.44 1" />
						</feComponentTransfer>
					</filter>
				</svg>
				<span class="bio__shape" aria-hidden="true"><Logo /></span>
				<img class="bio__photo" src="/images/cait_cutout.webp" alt="Cait Lorenzo-Mahon" width="900" height="908" loading="lazy" decoding="async" />
			</div>
			<div class="bio__strip panel">
				<dl class="bio__facts">
					<div>
						<dt>Status</dt>
						<dd class="bio__status"><span class="pulse" aria-hidden="true"></span>Open to opportunities</dd>
					</div>
					<div>
						<dt>Location</dt>
						<dd>Remote in Europe</dd>
					</div>
					<div>
						<dt>Experience</dt>
						<dd>10+ years in design and dev</dd>
					</div>
					<div>
						<dt>Languages</dt>
						<dd>English, French (learning!)</dd>
					</div>
				</dl>
				<a class="btn btn--primary bio__cv" href="/cv/">Request my CV</a>
			</div>
		</section>

		<section class="impact section" aria-labelledby="impact-heading">
			<h2 id="impact-heading" class="impact__title">A Drupal platform people rely on<span class="accent">.</span></h2>
			<p class="impact__lead">
				Leading content development on The Salvation Army's Drupal site, using GA4 and Looker Studio to measure what's working, then keep improving it.
			</p>
			<dl class="impact__grid">
				{
					IMPACT.map(({ figure, label }) => (
						<div class="impact__item">
							<dt>{label}</dt>
							<dd>{figure}</dd>
						</div>
					))
				}
			</dl>
			<p class="impact__source">Source: Google Analytics, 2025.</p>
		</section>

		<MilestoneStack />

		<section class="skills-box panel section" aria-labelledby="skills-heading">
			<header class="section__head">
				<div>
					<h2 id="skills-heading" class="section__title">Skills</h2>
				</div>
				<div class="skills-intro">
					<p class="skills-lead">Mainly Drupal and WordPress, with custom builds when a project needs them.</p>
					<p class="skills-key"><span class="skills-key__dot" aria-hidden="true"></span>Core skills</p>
				</div>
			</header>
			<ul class="groups" role="list">
				{
					SKILL_GROUPS.map(({ title, items }) => (
						<li class="group">
							<h3 class="group__title">{title}</h3>
							<ul class="tag-list" role="list">
								{
									items.map((item) => (
										<li class:list={["tag skill-tag", { "skill-tag--core": CORE_SKILLS.includes(item) }]} style={TECH_COLOURS[item] && `--brand:${TECH_COLOURS[item].colour};--brand-ink:${TECH_COLOURS[item].ink}`}>
											{TECH_ICONS[item] && (
												<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
													<path d={TECH_ICONS[item]} />
												</svg>
											)}
											{item}
										</li>
									))
								}
							</ul>
						</li>
					))
				}
			</ul>
		</section>

		<section class="why section" aria-labelledby="why-heading">
			<h2 id="why-heading" class="why__title">
				I care about making the web lighter on the planet, whether that's trimming bloated pages or compressing the 23MB image someone just uploaded<span class="accent">.</span>
			</h2>
			<p class="why__lead">A leaner site loads faster, ranks better and works for everyone, on any device or connection.</p>
		</section>

		<ContactPanel />
	</div>
</Base>

<style>
	.bio {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
		align-items: stretch;
		gap: clamp(32px, 6vw, 96px);
	}

	/* A black strip of the facts people look for first. */
	.bio__strip {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 24px clamp(24px, 3vw, 48px);
		margin-top: calc(-1 * clamp(0px, 3vw, 48px));
		padding: clamp(20px, 2.2vw, 28px) clamp(24px, 3vw, 40px);
		border-radius: var(--radius-tile);
	}

	.bio__facts {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 20px clamp(16px, 2vw, 32px);
		margin: 0;
	}

	.bio__facts > div {
		padding-left: clamp(16px, 2vw, 32px);
		border-left: 1px solid var(--line);
	}

	.bio__facts > div:first-child {
		padding-left: 0;
		border-left: 0;
	}

	.bio__facts dt {
		color: var(--mute);
		font-size: 0.8125rem;
	}

	.bio__facts dd {
		margin: 2px 0 0;
		font-size: 0.9375rem;
		font-weight: 500;
		line-height: 1.35;
	}

	.bio__status {
		display: flex;
		align-items: baseline;
		gap: 8px;
	}

	.bio__status .pulse {
		flex: none;
		transform: translateY(-1px);
	}

	.bio__text strong {
		color: var(--ink);
		font-weight: 600;
	}

	@media (max-width: 1160px) {
		.bio__strip {
			grid-template-columns: minmax(0, 1fr);
		}

		.bio__cv {
			justify-self: start;
		}
	}

	@media (max-width: 720px) {
		.bio__facts {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.bio__facts > div:nth-child(odd) {
			padding-left: 0;
			border-left: 0;
		}
	}

	@media (max-width: 420px) {
		.bio__facts {
			grid-template-columns: minmax(0, 1fr);
		}

		.bio__facts > div {
			padding-left: 0;
			border-left: 0;
		}
	}

	.bio__text {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 20px;
		color: var(--slate);
		font-size: clamp(17px, 1.4vw, 20px);
	}

	.bio__text .section__title {
		color: var(--ink);
	}

	/* Same purple in both themes. */
	.bio__card {
		position: relative;
		align-self: center;
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: var(--radius-panel);
		background: #a78bfa;
	}

	.bio__filter {
		position: absolute;
	}

	.bio__shape {
		position: absolute;
		top: 50%;
		right: -16%;
		width: 125%;
		translate: 0 -50%;
		color: #9576f6;
	}

	.bio__shape :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}

	.bio__photo {
		position: absolute;
		right: 0; /* the photo is cropped on this side, so it runs off the card's edge */
		bottom: 0;
		width: 80%;
		height: auto;
		filter: url(#about-duotone);
	}

	.impact {
		padding: clamp(40px, 6vw, 88px) var(--panel-pad);
		border-radius: var(--radius-panel);
		background: var(--stone);
	}

	.impact__title {
		max-width: 16ch;
		font-size: clamp(38px, 5.4vw, 80px);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.045em;
	}

	.impact__lead {
		max-width: 620px;
		margin-top: clamp(16px, 2vw, 24px);
		color: var(--slate);
		font-size: clamp(17px, 1.4vw, 20px);
	}

	.impact__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(20px, 3vw, 40px);
		margin: clamp(36px, 5vw, 64px) 0 0;
	}

	.impact__item {
		display: flex;
		flex-direction: column-reverse;
		justify-content: flex-end;
		gap: 8px;
		padding-top: 20px;
		border-top: 1px solid var(--ink);
	}

	.impact__item dt {
		color: var(--slate);
	}

	.impact__item dd {
		margin: 0;
		color: var(--accent);
		font-size: clamp(36px, 4.4vw, 64px);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.impact__source {
		margin-top: 24px;
		color: var(--mute);
		font-size: 0.8125rem;
	}

	.skills-box {
		padding: clamp(32px, 5vw, 80px) var(--panel-pad);
		border-radius: var(--radius-panel);
	}

	.groups {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(32px, 4vw, 56px) clamp(32px, 4vw, 64px);
	}

	.group {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding-top: 20px;
		border-top: 1px solid var(--ink);
	}

	.skill-tag {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}

	.skill-tag--core {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--on-accent);
		font-weight: 500;
	}

	.skills-intro {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.skills-key {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--slate);
		font-size: 0.875rem;
	}

	.skills-key__dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--accent);
	}

	.skills-lead {
		max-width: 400px;
		color: var(--slate);
		font-size: clamp(17px, 1.4vw, 20px);
	}



	.skill-tag svg {
		flex: none;
	}

	.group__title {
		font-size: clamp(20px, 1.8vw, 26px);
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -0.03em;
	}

	.why__title {
		max-width: 22ch;
		font-size: clamp(32px, 4.6vw, 68px);
		font-weight: 500;
		line-height: 1.04;
		letter-spacing: -0.04em;
	}

	.why__lead {
		max-width: 560px;
		margin-top: clamp(20px, 3vw, 32px);
		color: var(--slate);
		font-size: clamp(17px, 1.4vw, 20px);
	}

	@media (max-width: 860px) {
		.bio {
			grid-template-columns: 1fr;
		}

		.impact__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.groups {
			grid-template-columns: 1fr;
		}
	}
</style>

---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import ContactPanel from "../../components/ContactPanel.astro";
import { getProjects } from "../../lib/content";
import { SITE } from "../../data/site";
import { TECH_COLOURS } from "../../data/tech-colours";

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
	project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary, tags, status, year, live } = project.data;
// No point linking to the live site from inside it, as with this portfolio.
const liveElsewhere = live && !live.startsWith(String(Astro.site).replace(/\/$/, ""));
const { Content } = await render(project);
const hasBody = Boolean(project.body?.trim());
// Search results cut descriptions off at around 160 characters, so end on a whole word.
const description = summary.length <= 160 ? summary : `${summary.slice(0, 157).replace(/\s+\S*$/, "")}...`;

const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site) },
		{ "@type": "ListItem", position: 2, name: "Work", item: new URL("/work/", Astro.site) },
		{ "@type": "ListItem", position: 3, name: title, item: new URL(Astro.url.pathname, Astro.site) },
	],
};
---

<Base metaTitle={`${title}: Project by ${SITE.name}`} description={description}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
	<div class="container">
		<header class="project">
			<a class="project__back" href="/work/"><span aria-hidden="true">←</span> All projects</a>
			<h1 class="project__title">{title}</h1>
			<p class="project__summary">{summary}</p>
			{
				(status || year) && (
					<dl class="project__facts">
						{status && (
							<div>
								<dt>Status</dt>
								<dd>{status}</dd>
							</div>
						)}
						{year && (
							<div>
								<dt>Year</dt>
								<dd>{year}</dd>
							</div>
						)}
					</dl>
				)
			}
			<ul class="tag-list" role="list" aria-label="Technologies used">
				{tags.map((tag) => <li class="tag" style={TECH_COLOURS[tag] && `--brand:${TECH_COLOURS[tag].colour};--brand-ink:${TECH_COLOURS[tag].ink}`}>{tag}</li>)}
			</ul>
			{
				liveElsewhere && (
					<div class="project__links">
						<a class="btn btn--primary" href={live} target="_blank" rel="noopener noreferrer">View live site<span class="visually-hidden"> (opens in new tab)</span></a>
					</div>
				)
			}
		</header>

		{hasBody && <article class="prose"><Content /></article>}

		<ContactPanel />
	</div>
</Base>

<style>
	.project {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: clamp(20px, 2.6vw, 32px);
		padding-inline: var(--panel-pad);
		padding-top: clamp(32px, 5vw, 72px);
		animation: rise 0.8s var(--ease) both;
	}

	.project__back {
		color: var(--slate);
		font-size: 0.9375rem;
		text-decoration: none;
	}

	.project__back:hover {
		color: var(--ink);
	}

	.project__title {
		font-size: clamp(44px, 7vw, 104px);
		font-weight: 500;
		line-height: 0.98;
		letter-spacing: -0.05em;
		text-wrap: balance;
	}

	.project__summary {
		max-width: 820px;
		color: var(--slate);
		font-size: clamp(21px, 2.2vw, 30px);
		line-height: 1.3;
		letter-spacing: -0.02em;
		text-wrap: pretty;
	}

	.project__facts {
		display: flex;
		flex-wrap: wrap;
		gap: 16px 48px;
		margin: 0;
	}

	.project__facts dt {
		color: var(--mute);
		font-size: 0.9375rem;
	}

	.project__facts dd {
		margin: 2px 0 0;
		font-weight: 500;
	}

	.project__links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
</style>

---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import ContactPanel from "../../components/ContactPanel.astro";
import { formatDate, getPosts, readingTime } from "../../lib/content";
import { SITE } from "../../data/site";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, excerpt, tag, publishedAt, image = "/images/og-default.png", metaTitle, metaDescription = excerpt, cta } = post.data;
const { Content } = await render(post);
const date = publishedAt.toISOString().slice(0, 10);
const morePosts = (await getPosts()).filter(({ id }) => id !== post.id).slice(0, 3);

const postUrl = new URL(Astro.url.pathname, Astro.site);

const articleJsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: metaTitle ?? title,
	description: metaDescription,
	url: postUrl,
	mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
	image: new URL(image, Astro.site),
	datePublished: date,
	dateModified: date,
	author: { "@type": "Person", name: SITE.name, url: new URL("/about/", Astro.site) },
	keywords: tag,
};

const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site) },
		{ "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog/", Astro.site) },
		{ "@type": "ListItem", position: 3, name: title, item: postUrl },
	],
};
---

<Base title={title} metaTitle={metaTitle} description={metaDescription} ogType="article" image={image}>
	<Fragment slot="head">
		<meta property="article:published_time" content={date} />
		<meta property="article:author" content={SITE.name} />
		<meta property="article:section" content={tag} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
	</Fragment>
	<div class="container">
		<header class="intro">
			<a class="intro__back" href="/blog/"><span aria-hidden="true">←</span> All posts</a>
			<h1 class="intro__title">{title}</h1>
			<p class="intro__excerpt">{excerpt}</p>
			<dl class="intro__facts">
				<div>
					<dt>Written by</dt>
					<dd><a href="/about/">{SITE.name}</a></dd>
				</div>
				<div>
					<dt>Published</dt>
					<dd><time datetime={date}>{formatDate(publishedAt)}</time></dd>
				</div>
				<div>
					<dt>Reading time</dt>
					<dd>{readingTime(post.body)}</dd>
				</div>
				<div>
					<dt>Topic</dt>
					<dd>{tag}</dd>
				</div>
			</dl>
		</header>

		<article class="prose">
			<Content />
		</article>

		{
			cta && (
				<aside class="post-cta" aria-labelledby="post-cta-heading">
					<h2 id="post-cta-heading" class="post-cta__title">{cta.heading}</h2>
					<p class="post-cta__body">{cta.body}</p>
					<a class="btn btn--primary" href={`mailto:${SITE.email}?subject=${encodeURIComponent(cta.heading)}`}>Get in touch</a>
				</aside>
			)
		}

		{
			morePosts.length > 0 && (
				<section class="more section" aria-labelledby="more-heading">
					<h2 id="more-heading" class="more__title">More from the blog<span class="accent">.</span></h2>
					<ul class="more__list" role="list">
						{morePosts.map((other) => (
							<li class="more__card">
								<span class="more__tag">{other.data.tag}</span>
								<h3 class="more__name"><a href={`/blog/${other.id}/`}>{other.data.title}</a></h3>
								<span class="more__read" aria-hidden="true">Read post</span>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<ContactPanel />
	</div>
</Base>

<style>
	.intro {
		display: flex;
		flex-direction: column;
		gap: clamp(24px, 3vw, 40px);
		padding-inline: var(--panel-pad);
		padding-top: clamp(32px, 5vw, 72px);
		animation: rise 0.8s var(--ease) both;
	}

	.intro__back {
		align-self: flex-start;
		color: var(--slate);
		font-size: 0.9375rem;
		text-decoration: none;
	}

	.intro__back:hover {
		color: var(--ink);
	}

	.intro__title {
		max-width: 1200px;
		font-size: clamp(44px, 7vw, 104px);
		font-weight: 500;
		line-height: 0.98;
		letter-spacing: -0.05em;
		text-wrap: balance;
	}

	.intro__excerpt {
		max-width: 820px;
		color: var(--slate);
		font-size: clamp(21px, 2.2vw, 30px);
		line-height: 1.3;
		letter-spacing: -0.02em;
		text-wrap: pretty;
	}

	.intro__facts {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 20px 24px;
		margin: 0;
		padding-top: 24px;
		border-top: 1px solid var(--line);
	}

	.intro__facts dt {
		color: var(--mute);
		font-size: 0.9375rem;
	}

	.intro__facts dd {
		margin: 2px 0 0;
		font-weight: 500;
	}

	.intro__facts a {
		text-decoration: none;
	}

	.intro__facts a:hover {
		color: var(--accent);
	}

	.post-cta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
		max-width: 720px;
		margin: clamp(40px, 5vw, 64px) 0 0 var(--panel-pad);
		padding: clamp(24px, 3vw, 40px);
		border-radius: var(--radius-tile);
		background: var(--stone);
	}

	.post-cta__title {
		font-size: clamp(28px, 3vw, 40px);
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.post-cta__body {
		color: var(--slate);
		text-wrap: pretty;
	}

	@media (max-width: 720px) {
		.post-cta {
			margin-right: var(--panel-pad);
		}
	}

	.more {
		padding: var(--panel-pad);
		border-radius: var(--radius-panel);
		background: var(--stone);
	}

	.more__title {
		font-size: clamp(32px, 3.6vw, 56px);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.045em;
	}

	.more__list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
		margin-top: clamp(24px, 3vw, 40px);
	}

	.more__card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: clamp(20px, 2vw, 28px);
		border-radius: var(--radius-tile);
		background: var(--paper);
		transition: transform 0.25s var(--ease);
	}

	.more__card:hover {
		transform: translateY(-3px);
	}

	.more__tag {
		align-self: flex-start;
		padding: 2px 12px;
		border-radius: 999px;
		background: var(--ink);
		color: var(--paper);
		font-size: 0.8125rem;
		line-height: 1.7;
	}

	.more__name {
		font-size: 1.375rem;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	.more__name a {
		text-decoration: none;
	}

	/* The whole card is the link. */
	.more__name a::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.more__read {
		align-self: flex-start;
		margin-top: auto;
		border-bottom: 1px solid var(--ink);
		font-size: 0.9375rem;
		font-weight: 500;
	}

	@media (max-width: 860px) {
		.intro__facts {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.more__list {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
